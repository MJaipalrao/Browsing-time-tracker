{
  "manifest_version": 3,
  "name": "Browsing Time Tracker",
  "description": "Track browser usage time, visited domains, categories, timeline activity, and productivity insights.",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Browsing Time Tracker",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hotstar.com/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.twitch.tv/*",
        "*://*.spotify.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hulu.com/*",
        "*://*.sonyliv.com/*",
        "*://*.jiocinema.com/*",
        "*://*.zee5.com/*",
        "*://*.voot.com/*",
        "*://*.mxplayer.in/*"
      ],
      "js": ["src/media_watcher.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
